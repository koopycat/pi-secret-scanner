{
	"name": "pi-secret-scanner",
	"version": "0.2.4",
	"type": "module",
	"description": "Pi extension that scans outgoing LLM requests and file/bash tool results for secrets and redacts them before they leave the machine.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"security",
		"secrets",
		"redaction"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/koopycat/pi-secret-scanner.git"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "prettier --check . && eslint . && tsc --noEmit && vitest --run",
		"smoke": "node smoke/run.mjs",
		"fp-report": "node scripts/fp-report.ts"
	},
	"dependencies": {
		"smol-toml": "^1.7.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.74.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^26.0.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-n": "^18.2.1",
		"prettier": "^3.9.5",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.63.0",
		"vitest": "^3.2.0"
	}
}
